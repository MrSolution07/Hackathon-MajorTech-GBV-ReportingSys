{
  "expo": {
    "name": "SafeStep",
    "slug": "safestep",
    "scheme": "safestep",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#21105D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safestep.app"
    },
    "android": {
      "package": "com.safestep.app",
      "backgroundColor": "#21105D"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#F8F9FF"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
